# ── Infrastructure ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
VALKEY_URL=redis://localhost:6379/0
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# ── Embeddings ──────────────────────────────────────────────────
# OpenAI-compatible endpoint (works with Ollama, vLLM, TEI, OpenAI)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── LLM (for image description) ────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Storage ────────────────────────────────────────────────────
MEDIA_DIR=/data/media
MAX_UPLOAD_SIZE_MB=50

# ── Pipeline ───────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNKING_STRATEGY=recursive
ENABLE_HYBRID_SEARCH=false
ENABLE_OCR=false
ENABLE_IMAGE_DESCRIPTION=true

# ── Reranker ───────────────────────────────────────────────────
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
HF_TOKEN=

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8100
DEBUG=false
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
LOG_FORMAT=json
