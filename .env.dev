# ── Dev-Fast: Local development without application containers ────
# Data infra (Postgres, Valkey, Milvus) still runs in containers
# but the API server and worker run directly on the host with hot-reload.
#
# Usage:
#   make dev-up          # start data infra containers
#   make dev-fast        # run API with hot-reload
#   make dev-fast-worker # run worker directly
#   make dev-down        # stop data infra containers

# ── Infrastructure (uses docker-compose host port mappings) ─────
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag
VALKEY_URL=redis://localhost:6380/0
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=

# ── Embeddings ──────────────────────────────────────────────────
# Set EMBEDDING_BASE_URL to empty to use local sentence-transformers
# Or point to an OpenAI-compatible endpoint (Ollama, vLLM, TEI, etc.)
# For text+image omni embeddings set:
#   EMBEDDING_MODEL=jinaai/jina-embeddings-v5-omni-nano
#   EMBEDDING_DIM=768
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=codefuse-ai/F2LLM-v2-80M
EMBEDDING_DIM=320

# ── LLM (for image description) ────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Storage ────────────────────────────────────────────────────
MEDIA_DIR=./.dev-media
MAX_UPLOAD_SIZE_MB=50

# ── Pipeline ───────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNKING_STRATEGY=recursive
ENABLE_HYBRID_SEARCH=false
ENABLE_OCR=false
ENABLE_IMAGE_DESCRIPTION=false

# ── Reranker ───────────────────────────────────────────────────
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
HF_TOKEN=

# ── Worker ─────────────────────────────────────────────────────
WORKER_JOB_TIMEOUT=3600
# Max concurrent jobs processed per ARQ worker.
WORKER_MAX_JOBS=4
# A doc that exceeds WORKER_JOB_TIMEOUT is slow, not transiently failing — do
# NOT let ARQ re-run it (each attempt re-peaks the worker's memory).
WORKER_MAX_TRIES=1
WORKER_RETRY_JOBS=false
# Run each document's heavy parse/embed/insert in a killable subprocess so its
# memory is reclaimed when the job ends (success/timeout/OOM).
WORKER_RUN_IN_SUBPROCESS=true

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8100
DEBUG=true
CORS_ORIGINS='["*"]'
LOG_LEVEL=DEBUG
LOG_FORMAT=console
